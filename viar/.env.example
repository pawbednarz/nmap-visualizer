# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ── LLM Provider ───────────────────────────────────────────────────────────
# Choose "anthropic" or "openai"
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (GPT-4o) — only needed if LLM_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── Storage ────────────────────────────────────────────────────────────────
UPLOAD_DIR=/tmp/viar/uploads
OUTPUT_DIR=/tmp/viar/reports
FRAMES_DIR=/tmp/viar/frames
MAX_UPLOAD_SIZE=524288000  # 500 MB

# ── Server ─────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
DEBUG=false
LOG_LEVEL=INFO

# ── Security ───────────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-secure-random-string-in-production
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ── JIRA Integration (optional) ────────────────────────────────────────────
# JIRA_URL=https://yourcompany.atlassian.net
# JIRA_USER=your@email.com
# JIRA_API_TOKEN=your-jira-api-token
# JIRA_PROJECT_KEY=SEC
